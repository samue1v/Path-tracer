#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Constant data definition ------------------------------------

const float EPSILON = 1e-5;

const float MAX_FLOAT = 3.4028235e38;
const float MIN_FLOAT = -3.4028235e38;

const uint null_shape   =  0x00000000u;
const uint plane_shape  =  0x00000001u;
const uint sphere_shape =  0x00000010u;

const uint null_material = 0x00000000u;

const vec3 void_color = vec3(0.0,0.0,0.0);


// Struct definition -------------------------------------------

struct HitData {
  vec4 wo;
  vec4 hit;
  vec4 normal;
  vec4 throughput_depth;
};

struct PRNG32 {
    uvec4 state;
    float value;
};

struct PixelData{
	vec4 throughput_currentRay;
};

struct Sphere{
    vec4 center_radius;
    vec4 color;
};

struct Plane{
  vec4 center;
  vec4 edge1;
  vec4 edge2;
  vec4 color;
  float u;
  float v;
};
// Bindings ----------------------------------------------------

layout(set=0,binding = 0) uniform Camera {
  mat4 view;
  vec4 pos;
  float vp_dist;
} camera;


layout(std430, set = 0, binding = 1) buffer HitDataBuffer {
    HitData hit_data[];
};

layout(rgba8, binding = 2) uniform image2D StorageImage;

layout(std430, set = 0, binding = 3) buffer RNGBuffer{
    PRNG32 prng32[];
};


layout(std430, set = 0, binding = 4) buffer SpheresBuffer{
    Sphere spheres[];
};


layout(std430, set = 0, binding = 5) buffer PlanesBuffer{
    Plane planes[];
};


layout(std430, set = 0, binding = 6) buffer PixelDataBuffer{
	PixelData pixel_data[];
};

layout( push_constant ) uniform PushConstants{
  uint rpp;
  uint numSpheres;
  uint numPlanes;
  uint numLights;
} constants;

// Functions ---------------------------------------------------

uint TausStep(uint z, int S1, int S2, int S3, uint M)
{
    uint b = (((z << S1) ^ z) >> S2);
    return (((z & M) << S3) ^ b);    
}

uint LCGStep(uint z, uint A, uint C)
{
    return (A * z + C);    
}

float random(inout PRNG32 rng)
{
    rng.state.x = TausStep(rng.state.x, 13, 19, 12, 4294967294);
    rng.state.y = TausStep(rng.state.y, 2, 25, 4, 4294967288);
    rng.state.z = TausStep(rng.state.z, 3, 11, 17, 4294967280);
    rng.state.w = LCGStep(rng.state.w, 1664525, 1013904223);

    rng.value = 2.3283064365387e-10 * (rng.state.x ^ rng.state.y ^ rng.state.z ^ rng.state.w);

    return rng.value;
}

// Helpers optimization ----------------------------------------

float rRPP = 1.0/float(constants.rpp);

// Object intersection and shading -----------------------------

bool intersectionTest(in Plane plane, out vec3 hit_p,out float t ,inout HitData hd){
	vec3 e1 = plane.edge1.xyz;
	vec3 e2 = plane.edge2.xyz;
	vec3 center = plane.center.xyz;
	vec3 rayOrigin = hd.hit.xyz;
	vec3 rayDir = hd.wo.xyz;

	vec3 normal = normalize(cross(e1,e2));
	float denom = dot(normal, rayDir);

    if (abs(denom) < EPSILON)
        return false; // Ray is parallel to the plane

    t = dot(center - rayOrigin, normal) / denom;

    if (t < 0.0)
        return false; // Intersection is behind the ray

    vec3 hit = rayOrigin + t * rayDir;
    vec3 local = hit - center;

    float u = dot(local,e1); 
    float v = dot(local,e2);

    if (abs(u) > (plane.u * 0.5) || abs(v) > (plane.v * 0.5)){
        return false;
	}

	hit_p = hit;
    return true;
}

bool intersectionTest(in Sphere sphere, out vec3 hit_p, out float t, inout HitData hd) {
    vec3 rayOrigin = hd.hit.xyz;
    vec3 rayDir = hd.wo.xyz;
    vec3 oc = rayOrigin - sphere.center_radius.xyz;
	float radius = sphere.center_radius.w;

    float a = dot(rayDir, rayDir);
    float b = 2.0 * dot(oc, rayDir);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant < 0.0)
        return false;

    float sqrtDisc = sqrt(discriminant);
    float t0 = (-b - sqrtDisc) / (2.0 * a);
    float t1 = (-b + sqrtDisc) / (2.0 * a);

    t = (t0 > 0.0) ? t0 : t1;
    if (t < 0.0)
        return false;

    hit_p = rayOrigin + t * rayDir;
    return true;
}

void fillHitData(in Plane plane,in vec3 hit,inout HitData hd){

	hd.throughput_depth.xyz += plane.color.xyz;//vec3(1.0,1.0,1.0);
	hd.hit.xyz = hit;
	hd.normal.xyz = normalize(cross(plane.edge1.xyz,plane.edge2.xyz));
}

void fillHitData(in Sphere sphere, in vec3 hit_p, inout HitData hd) {
    hd.hit.xyz = hit_p;
    hd.normal.xyz = normalize(hit_p - sphere.center_radius.xyz);
    hd.throughput_depth.xyz += sphere.color.xyz; // example
}

bool Trace(inout HitData hd){
	uint nearestIndex = 0;
	uint nearestShape = null_shape;
	float nearestT = MAX_FLOAT;
	vec3 nearestHitP;
	const uint max_iterations = max(constants.numSpheres,constants.numPlanes);
	for(uint i = 0; i < max_iterations;++i){
		if(i < constants.numPlanes){
			float hit_t;
			vec3 hit_p;
			bool does_hit= intersectionTest(planes[i],hit_p,hit_t,hd);
			if(does_hit && hit_t < nearestT){
				nearestT = hit_t;
				nearestIndex = i;
				nearestShape = plane_shape;
				nearestHitP = hit_p;
			}
		}
		if(i < constants.numSpheres){
            float hit_t;
            vec3 hit_p;
            bool does_hit= intersectionTest(spheres[i],hit_p,hit_t,hd);
            if(does_hit && hit_t < nearestT){
                nearestT = hit_t;
                nearestIndex = i;
                nearestShape = sphere_shape;
                nearestHitP = hit_p;
            }
        }

		//Next one
	}

	if(nearestShape == null_shape){
		return false;
	}

	else if(nearestShape == plane_shape){
		fillHitData(planes[nearestIndex],nearestHitP,hd);
	}

	else if(nearestShape == sphere_shape){
		fillHitData(spheres[nearestIndex],nearestHitP,hd);
	}
	return true;
}

// Main --------------------------------------------------------

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    ivec2 imageSize = imageSize(StorageImage);
    uint index = gid.y * imageSize.x + gid.x;
	if(pixel_data[index].throughput_currentRay.w >= constants.rpp){
		return;
	}

    uint hd_index = index*constants.rpp +uint( pixel_data[index].throughput_currentRay.w);
	
	// Acquired Data
	HitData currentHitData =  hit_data[hd_index];
	//TESTE
    PRNG32 rng = prng32[index];
   
	vec4 color = vec4(void_color,1.0);

	int maxDepth = 1; // TEMPORARY

	// Trace scene

    bool hitSomething = Trace(currentHitData);
	color.xyz += currentHitData.throughput_depth.xyz;

	// Update Buffers
	//pixel_data[index].throughput_currentRay.xyz = color.xyz;
	if(hit_data[hd_index].throughput_depth.w+1 >= maxDepth || !hitSomething){
		pixel_data[index].throughput_currentRay.xyz += color.xyz*rRPP;
		pixel_data[index].throughput_currentRay.w += 1;
	}
	else{
		hit_data[hd_index].throughput_depth.w += 1;
		hit_data[hd_index].throughput_depth.xyz = color.xyz;
	}
    prng32[index] = rng;
	hit_data[hd_index] = currentHitData;
	// Store image
	vec4 newColor = vec4(pixel_data[index].throughput_currentRay.xyz,1.0);
    ivec2 pos = ivec2(gid);
    imageStore(StorageImage, pos,newColor );
}
