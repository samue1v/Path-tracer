// Constant data definition ------------------------------------

const float EPSILON = 1e-7;
const float DISPLACEMENT = 1e-3; 

const float MAX_FLOAT = 3.4028235e38;
const float MIN_FLOAT = -3.4028235e38;

const uint null_shape   =  0x0u;
const uint plane_shape  =  0x1u;
const uint sphere_shape =  0x2u;

const vec3 void_color = vec3(0.,0.,0.);

const float Pi      = 3.1415927;
const float InvPi   = 0.3183099;
const float Inv2Pi  = 0.1591549;
const float Inv4Pi  = 0.0795775;
const float PiOver2 = 1.5707963;
const float PiOver4 = 0.7853982;
const float Sqrt2   = 1.4142136;

const uint albedo_mat     = 0x0u;
const uint reflective_mat = 0x1u;
const uint refractive_mat = 0x2u;
const uint emissive_mat   = 0x4u;

const float gammaT = 1./2.2;
// CPU Struct definition -------------------------------------------

