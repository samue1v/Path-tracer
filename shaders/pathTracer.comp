// Functions ---------------------------------------------------

vec3 gammaCorrect(vec3 color) {
    return pow(color, vec3(gammaT));
}

uint TausStep(uint z, int S1, int S2, int S3, uint M)
{
    uint b = (((z << S1) ^ z) >> S2);
    return (((z & M) << S3) ^ b);    
}

uint LCGStep(uint z, uint A, uint C)
{
    return (A * z + C);    
}

float random(inout PRNG32 rng)
{
    rng.state.x = TausStep(rng.state.x, 13, 19, 12, 4294967294u);
    rng.state.y = TausStep(rng.state.y, 2, 25, 4, 4294967288u);
    rng.state.z = TausStep(rng.state.z, 3, 11, 17, 4294967280u);
    rng.state.w = LCGStep(rng.state.w, 1664525u, 1013904223u);

    float value = 2.3283064365387e-10f * float(rng.state.x ^ rng.state.y ^ rng.state.z ^ rng.state.w);

    return value;
}

vec2 sampleDisk(in float u,in float v){
	float uOffset = 2.*u - 1.;
	float vOffset = 2.*v - 1.;

	if(abs(uOffset) < EPSILON && abs(vOffset) < EPSILON){
		return vec2(0.,0.);
	}

	float theta, r;
	if (abs(uOffset) > abs(vOffset)) {
          r = uOffset;
          theta = PiOver4 * (vOffset / uOffset);
	}
	else {
    	r = vOffset;
        theta = PiOver2 - PiOver4 * (uOffset / vOffset);
    }
	return r * vec2(cos(theta), sin(theta));
}

float cosHemispherePDF(in float cosTheta){
	return InvPi*cosTheta;
}

vec3 cosSampleHemisphere(in float u, in float v){
	vec2 d = sampleDisk(u,v);
	float z = sqrt(max(0.0, 1 - d.x * d.x - d.y * d.y));
	return vec3(d.x,z,d.y);
}

mat3 buildTangentBasis(in vec3 normal) {
    vec3 up = abs(normal.y) < 0.999 ? vec3(0., 1., 0.) : vec3(1., 0., 0.);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return mat3(tangent, normal, bitangent); // Tangent-space to world-space
}

vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    //return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
	float comp = 1.0 - cosTheta;
    return F0 + (1.0 - F0) * (comp)*(comp)*(comp)*(comp)*(comp);
}


Fresnel fresnelSchlick(in vec3 wo,in vec3 normal, in vec3 F0, in float eta){
	float cosTheta;
	Fresnel f;
	vec3 r = refract(wo,normal,eta);
	if(eta <= 1.0 || dot(r,r) > EPSILON*EPSILON){
		cosTheta = eta <= 1.0 ? max(0.0,dot(-wo, normal)) : max(0.0,dot(r,-normal));
		f.TIR = false;
		f.wi = r;
		float comp = 1.0 - cosTheta;
		f.throughput = F0 + (1.0 - F0) * (comp)*(comp)*(comp)*(comp)*(comp);
	}
	else{
		// TIR
		f.TIR = true;
		f.wi = reflect(wo,normal);
		f.throughput = vec3(1.0);
	}
    return f; 
}

Sample sampleDiffuse(in vec3 worldNormal, inout PRNG32 rng) {
    float u1 = random(rng);
	float u2 = random(rng);

    vec3 local = cosSampleHemisphere(u1, u2);
    mat3 TNB = buildTangentBasis(worldNormal);
    vec3 worldDir = normalize(TNB * local);

    Sample s;
    s.dir = worldDir;
    s.pdf = cosHemispherePDF(max(dot(worldNormal, worldDir), 0.0));
    return s;
}



Sample sampleReflective(in vec3 wo, in vec3 worldNormal){
	Sample s;
	s.dir = reflect(wo,worldNormal);
	s.pdf = 1.;
	return s;
}

