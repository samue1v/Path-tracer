// Helpers optimization ----------------------------------------

float InvRPP = 1.0/float(constants.rpp);

// Object intersection and shading -----------------------------

bool intersectionTest(in Plane plane, out vec3 hit_p,out vec3 hit_normal,out float t ,in HitData hd){
	vec3 e1 = plane.edge1.xyz;
	vec3 e2 = plane.edge2.xyz;
	vec3 center = plane.center.xyz;
	vec3 rayOrigin = hd.hit.xyz;
	vec3 rayDir = hd.wo.xyz;

	vec3 normal = normalize(cross(e1,e2));
	float denom = dot(normal, rayDir);

    if (abs(denom) < EPSILON)
        return false; // Ray is parallel to the plane

    t = dot(center - rayOrigin, normal) / denom;

    if (t < EPSILON){
        return false; // Intersection is behind the ray
	}

    vec3 hit = rayOrigin + t * rayDir;
    vec3 local = hit - center;

    float u = dot(local,e1) / dot(e1,e1); 
    float v = dot(local,e2) / dot(e2,e2);

    if (abs(u) > (plane.uv_pad2.x * 0.5) || abs(v) > (plane.uv_pad2.y * 0.5)){
        return false;
	}
	
	hit_p = hit;
    hit_normal = normal;//denom < 0.0 && plane.mat.type_pad3.x == refractive_mat ? normal : -normal;
    return true;
}

bool intersectionTest(in Sphere sphere, out vec3 hit_p, out vec3 hit_normal, out float t, in HitData hd) {
    vec3 rayOrigin = hd.hit.xyz;
    vec3 rayDir = hd.wo.xyz;
    vec3 oc = rayOrigin - sphere.center_radius.xyz;
	float radius = sphere.center_radius.w;
	vec3 focus_dir = normalize(sphere.mat.type_pad3.yzw);
	bool isDome = dot(focus_dir,focus_dir) > EPSILON*EPSILON ? true : false;
	float domeLen = sphere.mat.emissive_reflectiveIdx.w;

    float a = dot(rayDir, rayDir);
    float b = 2.0 * dot(oc, rayDir);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant < 0.0)
        return false;

    float sqrtDisc = sqrt(discriminant);
    float t0 = (-b - sqrtDisc) / (2.0 * a);
    float t1 = (-b + sqrtDisc) / (2.0 * a);
	
	bool invert = false;
	if(!isDome){
    	t = (t0 > 0.0) ? t0 : t1;
    	if (t < 0.0)
    	    return false;

	}
	else{
		float rd_dot_focus = dot(rayDir,focus_dir);
		invert = sphere.mat.type_pad3.x == reflective_mat && rd_dot_focus > 0 ? true : false;
		float t_candidate = (rd_dot_focus >= 0) ? t1 : t0;
		if(t_candidate < 0.0){
			return false;
		}
		t = t_candidate;
  		vec3 temp_hit_p = rayOrigin + t * rayDir;
		vec3 dir = normalize(temp_hit_p - sphere.center_radius.xyz);
		if(dot(dir,focus_dir) < domeLen){
			return false;
		}
	}

    hit_p = rayOrigin + t * rayDir;
	hit_normal = invert == false ? normalize(hit_p - sphere.center_radius.xyz) : normalize(sphere.center_radius.xyz-hit_p);
    return true;
}

vec3 fillHitData(in Plane plane,in vec3 hit,inout HitData hd, inout PRNG32 rng){
	//hd.normal.xyz = normalize(cross(plane.edge1.xyz,plane.edge2.xyz));
	//vec3 n = normalize(cross(plane.edge1.xyz,plane.edge2.xyz));//hd.normal.xyz;
	vec3 n = cross(plane.edge1.xyz,plane.edge2.xyz);// Assuming vectors already normalized
	vec3 result = vec3(0.);

	Sample wi_pdf;
	if(plane.mat.type_pad3.x == albedo_mat){
		//wi_pdf = sampleDiffuse(hd.normal.xyz,rng);
		wi_pdf = sampleDiffuse(n,rng);
		hd.wo = vec4(wi_pdf.dir,0.0);
    	result =  plane.mat.albedo_refractiveIdx.xyz;
	}
	else if(plane.mat.type_pad3.x == reflective_mat){
		//wi_pdf = sampleReflective(hd.wo.xyz,hd.normal.xyz);
		wi_pdf = sampleReflective(hd.wo.xyz,n);
		hd.wo = vec4(wi_pdf.dir,0.0);
		//float cosTheta = max(dot(hd.normal.xyz, wi_pdf.dir), 0.0);
		float cosTheta = max(dot(n, wi_pdf.dir), 0.0);
		result = fresnelSchlick(cosTheta, vec3(plane.mat.emissive_reflectiveIdx.w));
	}
	else if(plane.mat.type_pad3.x == refractive_mat){
		vec3 original_wo = hd.wo.xyz;

		n = dot(original_wo, n) < 0.0 ? n : -n;
		//hd.normal.xyz = n;

		float cosThetaI = max(dot(n, -original_wo), 0.0);
		Fresnel F = fresnelSchlick(original_wo, n, plane.mat.albedo_refractiveIdx.xyz,plane.mat.albedo_refractiveIdx.w);
		if(!F.TIR){
			n = -n;
		}
		wi_pdf.dir = F.wi;
		wi_pdf.pdf = 1.0;
		hd.wo = vec4(F.wi,0.0);
		result = F.throughput;
	}
	
	//Floating point correction
	hit = hit + DISPLACEMENT*n;
	hd.hit.xyz = hit;

	return result;
}

vec3 fillHitData(in Sphere sphere, in vec3 hit_p, inout HitData hd, inout PRNG32 rng) {
	// TODO Sphere refract
    //hd.normal.xyz = normalize(hit_p - sphere.center_radius.xyz);
	vec3 n = normalize(hit_p - sphere.center_radius.xyz);//hd.normal.xyz;
	vec3 result = vec3(0.);
	Sample wi_pdf;
	if(sphere.mat.type_pad3.x == albedo_mat){
		//wi_pdf = sampleDiffuse(hd.normal.xyz,rng);
		wi_pdf = sampleDiffuse(n,rng);
		hd.wo = vec4(wi_pdf.dir,0.0);
    	result = sphere.mat.albedo_refractiveIdx.xyz;
	}
	else if(sphere.mat.type_pad3.x == reflective_mat){
		//wi_pdf = sampleReflective(hd.wo.xyz,hd.normal.xyz);
		wi_pdf = sampleReflective(hd.wo.xyz,n);
		hd.wo = vec4(wi_pdf.dir,0.0);
		//float cosTheta = max(dot(hd.normal.xyz, wi_pdf.dir), 0.0);
		float cosTheta = max(dot(n, wi_pdf.dir), 0.0);
		result =  fresnelSchlick(cosTheta, vec3(sphere.mat.emissive_reflectiveIdx.w));
	}

	else if(sphere.mat.type_pad3.x == refractive_mat){
		vec3 original_wo = hd.wo.xyz;

	    vec3 focus_dir = normalize(sphere.mat.type_pad3.yzw);
	    bool isDome = dot(focus_dir,focus_dir) > EPSILON*EPSILON ? true : false;
		float eta = sphere.mat.albedo_refractiveIdx.w;
		if(dot(original_wo, n) >= 0.0){
			n = -n;
			//eta = 1.0/eta;
			if(!isDome){
				eta = 1.0/eta;
			}
		}
		//hd.normal.xyz = n;

		float cosThetaI = max(dot(n, -original_wo), 0.0);
		Fresnel F = fresnelSchlick(original_wo, n, sphere.mat.albedo_refractiveIdx.xyz,eta);
		if(!F.TIR){
			n = -n;
		}
		wi_pdf.dir = F.wi;
		wi_pdf.pdf = 1.0;
		hd.wo = vec4(F.wi,0.0);
		result = F.throughput;
	}
	
	//Floating point correction
	hit_p = hit_p + DISPLACEMENT*n;
	hd.hit.xyz = hit_p;
	return result;
}

bool Trace(inout HitData hd, inout PRNG32 rng , out Material mat , out vec3 hit_throughput){
	uint nearestIndex = 0;
	uint nearestShape = null_shape;
	float nearestT = MAX_FLOAT;
	vec3 nearestNormal;
	vec3 nearestHitP;
	const uint max_iterations = max(constants.numSpheres,constants.numPlanes);
	for(uint i = 0; i < max_iterations;++i){
		float hit_t;
		vec3 hit_p;
		vec3 hit_normal;
		if(i < constants.numPlanes){
			bool does_hit= intersectionTest(planes[i],hit_p,hit_normal,hit_t,hd);
			if(does_hit && hit_t < nearestT){
				nearestT = hit_t;
				nearestIndex = i;
				nearestShape = plane_shape;
				nearestNormal = hit_normal;
				nearestHitP = hit_p;
			}
		}
		if(i < constants.numSpheres){
            bool does_hit= intersectionTest(spheres[i],hit_p,hit_normal,hit_t,hd);
            if(does_hit && hit_t < nearestT){
                nearestT = hit_t;
                nearestIndex = i;
                nearestShape = sphere_shape;
				nearestNormal = hit_normal;
                nearestHitP = hit_p;
            }
        }

		//Next one
	}

	if(nearestShape == null_shape){
		return false;
	}
	
	////Floating point correction
	//nearestHitP = nearestHitP + DISPLACEMENT*nearestNormal;
    if(nearestShape == plane_shape){
		hit_throughput = fillHitData(planes[nearestIndex],nearestHitP,hd,rng);
		mat = planes[nearestIndex].mat;
	}

	else if(nearestShape == sphere_shape){
		hit_throughput = fillHitData(spheres[nearestIndex],nearestHitP,hd,rng);
		mat = spheres[nearestIndex].mat;
	}
	return true;
}


void resetCamera(in uint hd_index, in uint idx ){
	PixelData pd = pixel_data[idx];
	uint f = idx*constants.rpp;

	for(uint i = 0; i < constants.rpp ; i++){
		uint c = f + i;
		HitData hd =  hit_data[c];
		hd.wo = constants.m*vec4(hd.init_wo.xyz,0.);
		hd.hit = constants.m*vec4(camera.pos.xyz,1.0);
		hd.throughput_depth = vec4(1.,1.,1.,0.);

		hit_data[c] = hd;

	}
	pd.radiance_currentRay = vec4(0.,0.,0.,0.);
	pixel_data[idx] = pd;

}

// Main --------------------------------------------------------

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    ivec2 imageSize = imageSize(StorageImage);
    uint index = gid.y * imageSize.x + gid.x;

    uint hd_index = index*constants.rpp +uint( pixel_data[index].radiance_currentRay.w);
	
	// Acquired Data
	HitData currentHitData =  hit_data[hd_index];
	PixelData currentPixelData = pixel_data[index];
    PRNG32 rng = prng32[index];

	if(constants.cameraMoved){
		resetCamera(hd_index,index);
		return;
	}

	if(pixel_data[index].radiance_currentRay.w >= constants.rpp){
		return;
	}

	//if(currentHitData.throughput_depth.w == 0){
	//	currentHitData.wo = camera.invView*currentHitData.wo;
	//	currentHitData.hit = camera.invView*currentHitData.hit;
	//}



	// Trace scene
	Material mat;
	//mat.albedo_refractiveIdx = vec4(1.,1.,1.,0.);
	//mat.emissive_reflectiveIdx = vec4(0.,0.,0.,0.);
	//mat.type_pad3 = vec4(0.,0.,0.,0.);
	vec3 hit_throughput = vec3(1.,1.,1.);
    bool hitSomething = Trace(currentHitData, rng, mat , hit_throughput);


	// Update Current Buffers


	// TESTE
	vec4 color = vec4(0.,0.,0.,0.);
	if(!hitSomething){

		currentPixelData.radiance_currentRay.xyz += currentHitData.throughput_depth.xyz*void_color*InvRPP;
		currentPixelData.radiance_currentRay.w += 1.;
	}
	else if(uint(mat.type_pad3.x) == emissive_mat){

		currentPixelData.radiance_currentRay.xyz += currentHitData.throughput_depth.xyz*mat.emissive_reflectiveIdx.xyz*InvRPP;
		currentPixelData.radiance_currentRay.w += 1.;
	}
	else{

		float p = max(hit_throughput.r, max(hit_throughput.g, hit_throughput.b));
		p = clamp(p, 0.1, 1.0);
		float rr = random(rng);
		if(uint(mat.type_pad3.x) == albedo_mat || uint(mat.type_pad3.x) == reflective_mat || uint(mat.type_pad3.x) == refractive_mat){	
			if(rr>p){

				currentPixelData.radiance_currentRay.xyz += currentHitData.throughput_depth.xyz*mat.albedo_refractiveIdx.xyz*InvRPP;
				currentPixelData.radiance_currentRay.w += 1.;
			}
			else{
	 
				currentHitData.throughput_depth.xyz *= hit_throughput/p;
				currentHitData.throughput_depth.w += 1;
			}
		}
	}

	
	// Write Data
    prng32[index] = rng;
	hit_data[hd_index] = currentHitData;
	pixel_data[index] = currentPixelData;

	// Store image
    ivec2 pos = ivec2(gid);
	color = vec4(gammaCorrect(currentPixelData.radiance_currentRay.xyz),0.0);
    imageStore(StorageImage, pos,color);

}
