    vec4 center_radius;
	Material mat;
};

struct Plane{
  vec4 center;
  vec4 edge1;
  vec4 edge2;
  vec4 uv_pad2;
  Material mat;
};


// GPU Struct definition

struct Sample{
	vec3 dir;
	float pdf;
};

