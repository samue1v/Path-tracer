#version 460

layout(local_size_x = 16, local_size_y = 16) in;

// Constant data definition ------------------------------------

const float EPSILON = 1e-7;
const float DISPLACEMENT = 1e-3; 

const float MAX_FLOAT = 3.4028235e38;
const float MIN_FLOAT = -3.4028235e38;

const uint null_shape   =  0x0u;
const uint plane_shape  =  0x1u;
const uint sphere_shape =  0x2u;

const vec3 void_color = vec3(0.,0.,0.);

const float Pi      = 3.1415927;
const float InvPi   = 0.3183099;
const float Inv2Pi  = 0.1591549;
const float Inv4Pi  = 0.0795775;
const float PiOver2 = 1.5707963;
const float PiOver4 = 0.7853982;
const float Sqrt2   = 1.4142136;

const uint albedo_mat     = 0x0u;
const uint reflective_mat = 0x1u;
const uint refractive_mat = 0x2u;
const uint emissive_mat   = 0x4u;


// CPU Struct definition -------------------------------------------

struct HitData {
  vec4 wo;
  vec4 hit;
  vec4 normal;
  vec4 throughput_depth;
};

struct PRNG32 {
    uvec4 state;
    float value;
	uvec3 _pad;
};

struct PixelData{
	vec4 radiance_currentRay;
};


struct Material{
 vec4 albedo_refractiveIdx;
 vec4 emissive_reflectiveIdx;
 vec4 type_pad3;
};

struct Sphere{
    vec4 center_radius;
	Material mat;
};

struct Plane{
  vec4 center;
  vec4 edge1;
  vec4 edge2;
  Material mat;
  float u;
  float v;
  uint _pad[2];
};


// GPU Struct definition

struct Sample{
	vec3 dir;
	float pdf;
};

// Bindings ----------------------------------------------------

layout(set=0,binding = 0) uniform Camera {
  mat4 view;
  mat4 invView;
  vec4 pos;
} camera;


layout(std430, set = 0, binding = 1) buffer HitDataBuffer {
    HitData hit_data[];
};

layout(rgba8, binding = 2) uniform image2D StorageImage;

layout(std430, set = 0, binding = 3) buffer RNGBuffer{
    PRNG32 prng32[];
};


layout(std430, set = 0, binding = 4) buffer SpheresBuffer{
Sphere spheres[];
};


layout(std430, set = 0, binding = 5) buffer PlanesBuffer{
    Plane planes[];
};


layout(std430, set = 0, binding = 6) buffer PixelDataBuffer{
	PixelData pixel_data[];
};

layout( push_constant ) uniform PushConstants{
  uint rpp;
  uint numSpheres;
  uint numPlanes;
  uint numLights;
} constants;

// Functions ---------------------------------------------------

uint TausStep(uint z, int S1, int S2, int S3, uint M)
{
    uint b = (((z << S1) ^ z) >> S2);
    return (((z & M) << S3) ^ b);    
}

uint LCGStep(uint z, uint A, uint C)
{
    return (A * z + C);    
}

float random(inout PRNG32 rng)
{
    rng.state.x = TausStep(rng.state.x, 13, 19, 12, 4294967294);
    rng.state.y = TausStep(rng.state.y, 2, 25, 4, 4294967288);
    rng.state.z = TausStep(rng.state.z, 3, 11, 17, 4294967280);
    rng.state.w = LCGStep(rng.state.w, 1664525, 1013904223);

    rng.value = 2.3283064365387e-10 * (rng.state.x ^ rng.state.y ^ rng.state.z ^ rng.state.w);

    return rng.value;
}

vec2 sampleDisk(in float u,in float v){
	float uOffset = 2.*u - 1.;
	float vOffset = 2.*v - 1.;

	if(abs(uOffset) < EPSILON && abs(vOffset) < EPSILON){
		return vec2(0.,0.);
	}

	float theta, r;
	if (abs(uOffset) > abs(vOffset)) {
          r = uOffset;
          theta = PiOver4 * (vOffset / uOffset);
	}
	else {
    	r = vOffset;
        theta = PiOver2 - PiOver4 * (uOffset / vOffset);
    }
	return r * vec2(cos(theta), (theta));
}

float cosHemispherePDF(in float cosTheta){
	return InvPi*cosTheta;
}

vec3 cosSampleHemisphere(in float u, in float v){
	vec2 d = sampleDisk(u,v);
	float z = sqrt(max(0.0, 1 - d.x * d.x - d.y * d.y));
	return vec3(d.x,z,d.y);
}

mat3 buildTangentBasis(in vec3 normal) {
    vec3 up = abs(normal.y) < 0.999 ? vec3(0., 1., 0.) : vec3(1., 0., 0.);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);
    return mat3(tangent, normal, bitangent); // Tangent-space to world-space
}

Sample sampleDiffuse(in vec3 worldNormal, inout PRNG32 rng) {
    float u1 = random(rng);
    float u2 = random(rng);

    vec3 local = cosSampleHemisphere(u1, u2);
    mat3 TNB = buildTangentBasis(worldNormal);
    vec3 worldDir = normalize(TNB * local);

    Sample s;
    s.dir = worldDir;
    s.pdf = cosHemispherePDF(max(dot(worldNormal, worldDir), 0.0));
    return s;
}


// Helpers optimization ----------------------------------------

float InvRPP = 1.0/float(constants.rpp);

// Object intersection and shading -----------------------------

bool intersectionTest(in Plane plane, out vec3 hit_p,out vec3 hit_normal,out float t ,in HitData hd){
	vec3 e1 = plane.edge1.xyz;
	vec3 e2 = plane.edge2.xyz;
	vec3 center = plane.center.xyz;
	vec3 rayOrigin = hd.hit.xyz;
	vec3 rayDir = hd.wo.xyz;

	vec3 normal = normalize(cross(e1,e2));
	float denom = dot(normal, rayDir);

    if (abs(denom) < EPSILON)
        return false; // Ray is parallel to the plane

    t = dot(center - rayOrigin, normal) / denom;

    if (t < 0.0)
        return false; // Intersection is behind the ray

    vec3 hit = rayOrigin + t * rayDir;
    vec3 local = hit - center;

    float u = dot(local,e1); 
    float v = dot(local,e2);

    if (abs(u) > (plane.u * 0.5) || abs(v) > (plane.v * 0.5)){
        return false;
	}

	hit_p = hit;
	hit_normal = normal;
    return true;
}

bool intersectionTest(in Sphere sphere, out vec3 hit_p, out vec3 hit_normal, out float t, in HitData hd) {
    vec3 rayOrigin = hd.hit.xyz;
    vec3 rayDir = hd.wo.xyz;
    vec3 oc = rayOrigin - sphere.center_radius.xyz;
	float radius = sphere.center_radius.w;

    float a = dot(rayDir, rayDir);
    float b = 2.0 * dot(oc, rayDir);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant < 0.0)
        return false;

    float sqrtDisc = sqrt(discriminant);
    float t0 = (-b - sqrtDisc) / (2.0 * a);
    float t1 = (-b + sqrtDisc) / (2.0 * a);

    t = (t0 > 0.0) ? t0 : t1;
    if (t < 0.0)
        return false;

    hit_p = rayOrigin + t * rayDir;
	hit_normal = normalize(hit_p - sphere.center_radius.xyz);
    return true;
}

vec3 fillHitData(in Plane plane,in vec3 hit,inout HitData hd, inout PRNG32 rng){

	//hd.throughput_depth.xyz += plane.color.xyz;//vec3(1.0,1.0,1.0);
	hd.hit.xyz = hit;
	hd.normal.xyz = normalize(cross(plane.edge1.xyz,plane.edge2.xyz));
	Sample wi_pdf = sampleDiffuse(hd.normal.xyz,rng);
	//hd.wo = vec4(hd.normal.xyz,0.);
	hd.wo = vec4(wi_pdf.dir,0.0);
	//return plane.mat.type_pad3.x == emissive_mat ? plane.mat.emissive_reflectiveIdx.xyz : plane.mat.albedo_refractiveIdx.xyz;
	return (plane.mat.albedo_refractiveIdx.xyz * InvPi) * dot(hd.normal.xyz,wi_pdf.dir) / wi_pdf.pdf;
}

vec3 fillHitData(in Sphere sphere, in vec3 hit_p, inout HitData hd, inout PRNG32 rng) {
    hd.hit.xyz = hit_p;
    hd.normal.xyz = normalize(hit_p - sphere.center_radius.xyz);
	Sample wi_pdf = sampleDiffuse(hd.normal.xyz,rng);
	//hd.wo = vec4(hd.normal.xyz,0.);
	hd.wo = vec4(wi_pdf.dir,0.0);
    return sphere.mat.albedo_refractiveIdx.xyz;
}

bool Trace(inout HitData hd, inout PRNG32 rng , out Material mat , out vec3 hit_throughput){
	uint nearestIndex = 0;
	uint nearestShape = null_shape;
	float nearestT = MAX_FLOAT;
	vec3 nearestNormal;
	vec3 nearestHitP;
	const uint max_iterations = max(constants.numSpheres,constants.numPlanes);
	for(uint i = 0; i < max_iterations;++i){
		if(i < constants.numPlanes){
			float hit_t;
			vec3 hit_p;
			vec3 hit_normal;
			bool does_hit= intersectionTest(planes[i],hit_p,hit_normal,hit_t,hd);
		if(does_hit && hit_t < nearestT){
			nearestT = hit_t;
				nearestIndex = i;
				nearestShape = plane_shape;
				nearestNormal = hit_normal;
				nearestHitP = hit_p;
			}
		}
		if(i < constants.numSpheres){
            float hit_t;
            vec3 hit_p;
			vec3 hit_normal;
            bool does_hit= intersectionTest(spheres[i],hit_p,hit_normal,hit_t,hd);
            if(does_hit && hit_t < nearestT){
                nearestT = hit_t;
                nearestIndex = i;
                nearestShape = sphere_shape;
				nearestNormal = hit_normal;
                nearestHitP = hit_p;
            }
        }

		//Next one
	}

	if(nearestShape == null_shape){
		return false;
	}
	
	//Floating point correction
	nearestHitP = nearestHitP + DISPLACEMENT*nearestNormal;
    if(nearestShape == plane_shape){
		hit_throughput = fillHitData(planes[nearestIndex],nearestHitP,hd,rng);
		mat = planes[nearestIndex].mat;
	}

	else if(nearestShape == sphere_shape){
		hit_throughput = fillHitData(spheres[nearestIndex],nearestHitP,hd,rng);
		mat = spheres[nearestIndex].mat;
	}
	return true;
}

// Main --------------------------------------------------------

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    ivec2 imageSize = imageSize(StorageImage);
    uint index = gid.y * imageSize.x + gid.x;
	if(pixel_data[index].radiance_currentRay.w >= constants.rpp){
		return;
	}

    uint hd_index = index*constants.rpp +uint( pixel_data[index].radiance_currentRay.w);
	
	// Acquired Data
	HitData currentHitData =  hit_data[hd_index];
	PixelData currentPixelData = pixel_data[index];
    PRNG32 rng = prng32[index];


	// Trace scene
	Material mat;
	vec3 hit_throughput;
    bool hitSomething = Trace(currentHitData, rng, mat , hit_throughput);


	// Update Current Buffers


	// TESTE
	vec4 color = vec4(0.,0.,0.,1.);
	if(!hitSomething){

		currentPixelData.radiance_currentRay.xyz += currentHitData.throughput_depth.xyz*void_color*InvRPP;
		currentPixelData.radiance_currentRay.w += 1.;
	}
	else if(uint(mat.type_pad3.x) == emissive_mat){

//		color = vec4(1.,1.,1.,1.);
		currentPixelData.radiance_currentRay.xyz += currentHitData.throughput_depth.xyz*mat.emissive_reflectiveIdx.xyz*InvRPP;
		currentPixelData.radiance_currentRay.w += 1.;
	}
	else if(uint(mat.type_pad3.x) == albedo_mat){	

		currentHitData.throughput_depth.xyz *= hit_throughput;
		currentHitData.throughput_depth.w += 1;
	}
	else{
		//currentHitData.throughput_depth.w += 1;
	}


	// Write Data
    prng32[index] = rng;
	hit_data[hd_index] = currentHitData;
	pixel_data[index] = currentPixelData;

	// Store image
    ivec2 pos = ivec2(gid);
	color = vec4(currentPixelData.radiance_currentRay.xyz,1.0);
    imageStore(StorageImage, pos,color);
}
